  "defaultWindow": 1000000,
  "windowRules": [
    { "pattern": "1m|\\[1m\\]",                         "window": 1000000, "note": "显式带 [1m] 标记的" },
    { "pattern": "opus-4-[78]|opus-5|sonnet-5|fable-5", "window": 1000000, "note": "默认 1M 窗口 (Opus 4.7/4.8/5/5.5, Sonnet 5, Fable 5; opus-5 这一段同时命中 claude-opus-5-5)。4.8 已从 options 移除但这里保留: ANTHROPIC_MODEL 环境变量可绕过 UI 直接指定, 窗口/归桶仍需算对" },
    { "pattern": "haiku|sonnet-4",                      "window": 200000,  "note": "已知 200k: haiku 全系 + sonnet-4 全系(含 4.6)。原写法 sonnet-4[^-]|sonnet-4$ 匹配不到 claude-sonnet-4-6(它后面跟的是横杠), 于是掉进 defaultWindow=1M —— 分母比真实大 5 倍, 自动压缩永远够不着阈值, 一路撞真实上限。带 [1m] 的变体会被上面第一条先命中(首命中为准), 不会被误降到 200k" }
  ],
  "rateGateFamilies": {
    "opus": {
      "models": ["claude-opus-4-5", "claude-opus-4-6", "claude-opus-4-7", "claude-opus-4-8", "claude-opus-5", "claude-opus-5-5"],
