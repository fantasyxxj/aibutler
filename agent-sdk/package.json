{
  "name": "@butler/agent-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-provider agent SDK. Drop-in for the subset of @anthropic-ai/claude-agent-sdk that butler uses: query() / tool() / createSdkMcpServer().",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node/index.d.ts", "import": "./dist/node/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.96",
    "@ai-sdk/deepseek": "*",
    "@ai-sdk/openai": "*",
    "@ai-sdk/openai-compatible": "*",
    "ai": "7.0.162"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  }
}
