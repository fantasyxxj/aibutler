{
  "name": "butler",
  "version": "1.0.12",
  "description": "全能管家",
  "main": "personal/main.js",
  "engines": {
    "node": ">=20 <26"
  },
  "scripts": {
    "start": "electron .",
    "dist:mac": "node scripts/dist.js --mac",
    "dist:mac:intel": "node scripts/dist.js --mac --x64",
    "dist:win": "node scripts/dist.js --win",
    "dist:mac:locked": "node scripts/dist.js --mac --locked",
    "dist:win:locked": "node scripts/dist.js --win --locked",
    "prepack": "node scripts/vendor-embed.js",
    "build:agent-sdk": "npm --prefix agent-sdk install --no-audit --no-fund && npm --prefix agent-sdk run build",
    "test:semantic": "node personal/test-memory-semantic.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "@butler/agent-sdk": "file:agent-sdk",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "katex": "^0.17.0",
    "mermaid": "^11.16.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.53.0",
    "node-sqlite3-wasm": "^0.8.60",
    "qrcode-generator": "^2.0.4",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1"
  },
  "build": {
    "appId": "com.fantasyxxj.butler",
    "productName": "全能管家",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "personal/config/**/*.md",
      "core/config/**/*.md",
      "!personal/test-*.js",
      "!industry/**",
      "!education/**",
      "!.devdata-bak-*/**",
      "!.zshrc",
      "!verify/**",
      "!scripts/**",
      "!.codemap-unowned",
      "!build/**",
      "!release/**",
      "!dist/**",
      "!logs/**",
      "!personas/**",
      "!app/**",
      "!personas.json",
      "!personas.json.bak",
      "!.opentabs.json",
      "!.session.json.migrated",
      "!.claude/**",
      "!personal/.claude/**",
      "!memory/**",
      "!workspace/**",
      "!docs/**",
      "!**/.DS_Store",
      "!models/**",
      "!whisper/**",
      "!**/@anthropic-ai/claude-agent-sdk/**",
      "!**/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "全能管家需要访问麦克风以支持语音输入(与人格语音对话/听写)。",
        "NSCameraUsageDescription": "全能管家可能需要访问摄像头用于视频输入(可选功能)。"
      },
      "extraResources": [
        {
          "from": "build/bin/mac/whisper/whisper-cli",
          "to": "whisper/bin/darwin/whisper-cli"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "asarUnpack": [
      "personal/renderer/vendor/**"
    ],
    "copyright": "Copyright © 2026 fantasyxxj"
  },
  "author": {
    "name": "fantasyxxj",
    "url": "https://github.com/fantasyxxj"
  }
}
